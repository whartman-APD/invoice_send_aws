# Local Docker configuration (docker-compose.yml reads .env)
#
# 1. Copy this file to .env: copy .env.template .env
# 2. Fill in the AWS key and adjust values as needed
# 3. See README.md in this folder for what each variable does and the IAM permissions the key needs
#
# .env is git-ignored. On AWS these values come from infra/ecs.tf + infra/terraform.tfvars instead;
# when adding a variable, add it in both places.

# ==============================================================================
# AWS Configuration
# ==============================================================================

# IAM user access key for local runs (needs Secrets Manager + DynamoDB read; see README.md)
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>

# AWS Region where your resources are located
AWS_REGION=us-west-2

# ==============================================================================
# AWS Secrets Manager - Secret Names
# ==============================================================================
# Names of secrets in AWS Secrets Manager (key layouts are listed in README.md)

# QuickBooks Online credentials (client_id, client_secret, realm_id, refresh_token, access_token)
QBO_SECRET_NAME=QBO/10000

# Microsoft Graph credentials (tenant_id, client_id, client_secret_value, hostname)
MSGRAPH_SECRET_NAME=MsGraph/10000

# ClickUp API credentials
CLICKUP_SECRET_NAME=ClickUp/10000

# Robocorp Control Room API keys (one per client)
ROBOCORP_API_SECRET_NAME=RoboCorp/10000/ClientAPIKeys

# GitHub PAT for the weekly digest (key: GITHUB_PAT)
GITHUB_PAT_SECRET_NAME=GitHub/10000/PersonalAccessToken

# Azure OpenAI credentials for the weekly digest (keys: AZURE_OPENAI_API_KEY, AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_DEPLOYMENT, AZURE_OPENAI_API_VERSION)
AZURE_OPENAI_SECRET_NAME=AzureOpenAI/10000

# Weekly GitHub digest email addresses (variable names say MONTHLY for historical reasons)
MONTHLY_DIGEST_EMAIL_FROM=robotarmy@automatapracdev.com
MONTHLY_DIGEST_EMAIL_TO=allstaff@automatapracdev.com

# ClickUp doc page for the weekly digest (new section prepended at top with date header)
CLICKUP_DIGEST_WORKSPACE_ID=9009105550
CLICKUP_DIGEST_DOC_ID=8cfr2me-7174
CLICKUP_DIGEST_PAGE_ID=8cfr2me-19254

# ==============================================================================
# DynamoDB Configuration
# ==============================================================================
# Table storing client organization and workspace IDs
# Your AWS credentials must have read access to this table
DYNAMODB_TABLE_ROBOCORP_CLIENTS=Robocorp_Client_Org_Workspace_IDs

# ==============================================================================
# Email Configuration
# ==============================================================================

# Email address of the bookkeeper (receives invoice summary)
BOOKKEEPER_EMAIL=whartman@automatapracdev.com

# Sender email address (from address for emails)
SENDER_EMAIL=robotarmy@automatapracdev.com

# send-invoices only: QBO customer names never sent invoices (comma-separated)
EXCLUDED_CUSTOMERS=10001 - AICPA

# ==============================================================================
# Microsoft Graph / SharePoint Configuration
# ==============================================================================

# SharePoint hostname for file uploads
MS_GRAPH_HOSTNAME=automatapracdev.sharepoint.com

# ==============================================================================
# Invoice Creation Configuration
# ==============================================================================

# create-invoices normally runs on AWS. These gate every write it makes; all false = read-only dry run.
UPLOAD_TO_SHAREPOINT=false
CREATE_INVOICE=false
UPDATE_CLICKUP=false

# Client ID range for processing (inclusive lower bound, exclusive upper bound)
LOWER_CLIENT_ID=10000
UPPER_CLIENT_ID=10040

# Comma-separated list of client IDs with NET 30 payment terms
NET_30_DAYS_CLIENTS=10020

# ==============================================================================
# Billing Period Configuration
# ==============================================================================

# First day of the billing month (YYYY-MM-DD). Leave unset: the billing month defaults to the prior
# calendar month (a run in October bills September and compares it with August).
#BILLING_REFERENCE_DATE=2026-09-01

# ==============================================================================
# Azure SQL Server Configuration (for Robocorp process sync)
# ==============================================================================

# Secrets Manager secret holding the Azure SQL connection details
# (keys: AZURE_SQL_SERVER, AZURE_SQL_DATABASE, AZURE_SQL_USERNAME, AZURE_SQL_PASSWORD)
AZURE_SQL_SECRET_NAME=AzureSQLServer/10000
